# CORPORATE (PREVIEW ONLY) — no secrets or real values in this file.
# Keep the existing NEXT_PUBLIC_FIREBASE_* and NEXT_PUBLIC_ORG_ID from the isolated client test Firebase.
# NEVER point a preview that permits CRUD at Nelcy production Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_ORG_ID=

# Server-only Control integration; configure in Vercel Preview branch scope, NOT as NEXT_PUBLIC_*
NIXINX_CONTROL_API_URL=
NIXINX_CONTROL_SERVICE_TOKEN=
NIXINX_CONTROL_TENANT_ID=
NIXINX_CORPORATE_HOSTNAME=
NIXINX_PREVIEW_FIREBASE_PROJECT_ID=

# Production at nelcy.corporate.nixinx.app: enable after Control issues a production lease.
NIXINX_CORPORATE_PRODUCTION_GATE=
